# CareerPilot AI Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Security & Authentication
SECRET_KEY=careerpilot_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./careerpilot.db

# LLM / AI Configuration (Provider Independent)
# Supported Providers: "openai", "gemini", "anthropic", "local"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.7

# Demo Mode Configuration
# When DEMO_MODE=True, the system uses rich offline datasets & local heuristic NLP agents
# when no external API key is provided, ensuring 100% functionality out of the box.
DEMO_MODE=True

# Uploads Directory
UPLOAD_DIR=./uploads
